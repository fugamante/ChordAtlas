{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chordatlas.org/schemas/song-chart.schema.json",
  "title": "ChordAtlas SongChart",
  "description": "Canonical Layer 0 JSON export contract for a ChordAtlas song chart.",
  "type": "object",
  "required": ["schema_version", "title", "tuning", "capo", "version", "sections"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0",
      "description": "Normalized JSON export contract version."
    },
    "title": { "type": "string", "minLength": 1 },
    "artist": { "type": "string" },
    "key": { "type": "string" },
    "tuning": { "type": "string" },
    "capo": { "type": "string" },
    "version": { "type": "string" },
    "confidence": { "$ref": "#/$defs/confidence" },
    "source": { "type": "string" },
    "voicing_notes": { "$ref": "#/$defs/stringList" },
    "version_history": {
      "type": "array",
      "items": { "$ref": "#/$defs/versionEntry" }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "roman": { "$ref": "#/$defs/scalarList" },
        "nashville": { "$ref": "#/$defs/scalarList" }
      }
    },
    "performance_notes": { "$ref": "#/$defs/stringList" },
    "recording_notes": { "$ref": "#/$defs/stringList" },
    "recordings": {
      "type": "array",
      "items": { "$ref": "#/$defs/recordingSource" }
    },
    "structured_recording_notes": {
      "type": "array",
      "items": { "$ref": "#/$defs/recordingNoteGroup" }
    },
    "sections": {
      "type": "array",
      "items": { "$ref": "#/$defs/section" }
    },
    "provenance": {
      "$ref": "https://chordatlas.org/schemas/provenance-record.schema.json#/$defs/provenanceList"
    },
    "metadata_provenance": {
      "$ref": "https://chordatlas.org/schemas/provenance-record.schema.json#/$defs/provenanceMap"
    },
    "chord_provenance": {
      "$ref": "https://chordatlas.org/schemas/provenance-record.schema.json#/$defs/provenanceMap"
    },
    "analysis_provenance": {
      "$ref": "https://chordatlas.org/schemas/provenance-record.schema.json#/$defs/provenanceMap"
    },
    "performance_note_provenance": {
      "$ref": "https://chordatlas.org/schemas/provenance-record.schema.json#/$defs/provenanceMap"
    },
    "recording_note_provenance": {
      "$ref": "https://chordatlas.org/schemas/provenance-record.schema.json#/$defs/provenanceMap"
    }
  },
  "$defs": {
    "confidence": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "stringList": {
      "type": "array",
      "items": { "type": "string" }
    },
    "scalarList": {
      "type": "array",
      "items": {
        "type": ["string", "number", "integer", "boolean"]
      }
    },
    "section": {
      "type": "object",
      "required": ["name", "bars"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "bars": {
          "type": "array",
          "items": { "$ref": "#/$defs/measure" }
        },
        "repeat": { "type": "string" },
        "notes": { "$ref": "#/$defs/stringList" },
        "provenance": {
          "$ref": "https://chordatlas.org/schemas/provenance-record.schema.json#/$defs/provenanceList"
        }
      }
    },
    "measure": {
      "oneOf": [
        {
          "type": "array",
          "items": { "type": "string" }
        },
        {
          "type": "object",
          "required": ["chords"],
          "additionalProperties": false,
          "properties": {
            "chords": {
              "type": "array",
              "items": { "type": "string" }
            },
            "timestamp": { "type": "string" },
            "provenance": {
              "$ref": "https://chordatlas.org/schemas/provenance-record.schema.json#/$defs/provenanceList"
            }
          }
        }
      ]
    },
    "versionEntry": {
      "type": "object",
      "required": ["version", "changes"],
      "additionalProperties": false,
      "properties": {
        "version": { "type": "string" },
        "changes": { "$ref": "#/$defs/stringList" },
        "provenance": {
          "$ref": "https://chordatlas.org/schemas/provenance-record.schema.json#/$defs/provenanceList"
        }
      }
    },
    "recordingNoteGroup": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "notes": {
          "type": "array",
          "items": { "$ref": "#/$defs/recordingNote" }
        },
        "value": { "$ref": "#/$defs/recordingNote" },
        "category": { "type": "string" },
        "severity": { "type": "string" },
        "recording_ids": { "$ref": "#/$defs/stringList" },
        "provenance": {
          "$ref": "https://chordatlas.org/schemas/provenance-record.schema.json#/$defs/provenanceList"
        }
      },
      "anyOf": [
        { "required": ["notes"] },
        { "required": ["value"] }
      ]
    },
    "recordingNote": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "required": ["text"],
          "additionalProperties": false,
          "properties": {
            "text": { "type": "string", "minLength": 1 },
            "confidence": { "$ref": "#/$defs/confidence" },
            "claim_origin": {
              "$ref": "https://chordatlas.org/schemas/provenance-record.schema.json#/$defs/claimOrigin"
            },
            "category": { "type": "string" },
            "severity": { "type": "string" },
            "recording_ids": { "$ref": "#/$defs/stringList" },
            "provenance": {
              "$ref": "https://chordatlas.org/schemas/provenance-record.schema.json#/$defs/provenanceList"
            }
          }
        }
      ]
    },
    "recordingSource": {
      "type": "object",
      "required": ["id", "title"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "source_url": { "type": "string" },
        "version_label": { "type": "string" },
        "notes": { "$ref": "#/$defs/stringList" },
        "provenance": {
          "$ref": "https://chordatlas.org/schemas/provenance-record.schema.json#/$defs/provenanceList"
        }
      }
    }
  }
}
